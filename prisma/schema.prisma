generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  email        String       @unique
  role         Role         @default(STUDENT)
  enrollments  Enrollment[]
  attempts     Attempt[]
  coursesOwned Course[]     @relation("InstructorCourses")
  certificates Certificate[]
  createdAt    DateTime     @default(now())
}

enum Role {
  STUDENT
  INSTRUCTOR
}

model Course {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  instructor  User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  instructorId String      @db.ObjectId
  modules     Module[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
}

model Module {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  title    String
  order    Int
  course   Course   @relation(fields: [courseId], references: [id])
  courseId String   @db.ObjectId
  lessons  Lesson[]
}

model Lesson {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  type        LessonType  @default(TEXT)
  content     String
  order       Int
  module      Module      @relation(fields: [moduleId], references: [id])
  moduleId    String      @db.ObjectId
  objectives  Objective[]
}

enum LessonType {
  TEXT
  VIDEO
}

model Objective {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  description    String
  rubricCriteria String[] // List of checkable statements
  maxTurns       Int      @default(3)
  lesson         Lesson   @relation(fields: [lessonId], references: [id])
  lessonId       String   @db.ObjectId
  attempts       Attempt[]
}

model Attempt {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  user            User           @relation(fields: [userId], references: [id])
  userId          String         @db.ObjectId
  objective       Objective      @relation(fields: [objectiveId], references: [id])
  objectiveId     String         @db.ObjectId
  conversation    Json           // Array of {role: 'user'|'agent', content: string}
  turnCount       Int            @default(0)
  status          AttemptStatus  @default(IN_PROGRESS)
  coverage        Json?          // Per-criterion status: { criterion: 'met'|'partial'|'missing' }
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum AttemptStatus {
  IN_PROGRESS
  MASTERED
  PARTIAL
  OFF_TRACK
}

model Enrollment {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  user        User      @relation(fields: [userId], references: [id])
  userId      String    @db.ObjectId
  course      Course    @relation(fields: [courseId], references: [id])
  courseId    String    @db.ObjectId
  progressPct Float     @default(0.0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, courseId])
}

model Certificate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  courseId  String   @db.ObjectId
  code      String   @unique
  issuedAt  DateTime @default(now())
}
